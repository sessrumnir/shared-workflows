{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>sessrumnir/shared-workflows//renovate/default"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images in role defaults, one reference pinned by tag and digest",
      "managerFilePatterns": ["/^roles/[^/]+/defaults/main\\.yml$/"],
      "matchStrings": [
        "(?<depName>[a-z0-9-]+(?:\\.[a-z0-9-]+)+(?::[0-9]+)?/[a-z0-9._/-]+):(?<currentValue>[\\w][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["roles/**"],
      "semanticCommitType": "fix"
    },
    {
      "description": "A major moves the galaxy.yml range to the next major (>=14,<15) and releases the collection",
      "matchManagers": ["ansible-galaxy"],
      "matchFileNames": ["galaxy.yml"],
      "semanticCommitType": "fix"
    }
  ]
}
